// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("PATIENT") // PATIENT, DOCTOR, NURSE, ADMIN, PHARMACIST, ACCOUNTANT, RECEPTIONIST
  phone     String?
  address   String?
  dob       DateTime?
  gender    String?  // MALE, FEMALE, OTHER
  identityId String? @unique // CCCD
  healthInsuranceNo String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments       Appointment[]
  doctorInfo         Doctor?
  nurseInfo          Nurse?
  medicalRecords     MedicalRecord[]
  inpatientRecords   InpatientRecord[]
  surgeryOrders      SurgeryOrder[]
  articles           Article[]
}

model Department {
  id          String   @id @default(cuid())
  code        String   @unique // KHOA_KHAM_BENH, KHOA_CAP_CUU...
  name        String
  description String?
  type        String   @default("KHOA") // KHOI, KHOA, PHONG_KHAM, DON_VI, PHONG, TRUNG_TAM
  floor       String?
  
  // Hierarchical Structure
  parentId    String?
  parent      Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DepartmentHierarchy")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors           Doctor[]
  nurses            Nurse[]
  appointments      Appointment[] // Nơi đăng ký đến khám
  rooms             Room[]
  staffShifts       StaffShift[]
   
  @@index([parentId])
  @@index([type])
}

model Doctor {
  id           String   @id @default(cuid())
  specialty    String
  bio          String?
  licenseNo    String?
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  departmentId String   // Trực thuộc Khoa/Phòng nào
  department   Department @relation(fields: [departmentId], references: [id])
  
  consultationFee Float  @default(0) // Giá khám
  isSpecialist Boolean  @default(false) // Bác sĩ chuyên gia?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointments         Appointment[]
  inpatientRecords     InpatientRecord[]
  medicalOrders        MedicalOrder[]
  surgeryOrders        SurgeryOrder[]
  shifts               StaffShift[]
  
  @@index([departmentId])
}

model Nurse {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String   
  department  Department @relation(fields: [departmentId], references: [id])
  position    String?  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shifts      StaffShift[]

  @@index([departmentId])
}

model StaffShift {
  id            String   @id @default(cuid())
  dayOfWeek     String?  // MONDAY, TUESDAY, ... cho ca lặp lại
  scheduleDate  DateTime? // Ngày cụ thể cho ca làm một lần
  shiftType     String   @default("DAY") // DAY, EVENING, NIGHT
  startTime     String
  endTime       String
  notes         String?

  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  doctorId      String?
  doctor        Doctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  nurseId       String?
  nurse         Nurse?   @relation(fields: [nurseId], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([departmentId])
  @@index([doctorId])
}

// ----------------------------------------------------------------------
// WORKFLOW KHÁM BỆNH V2 (Appointments & Medical Workflow)
// ----------------------------------------------------------------------

model Appointment {
  id                String   @id @default(cuid())
  appointmentCode   String   @unique // DK202610150001
  
  date              DateTime
  timeSlot          String?  // "08:15"
  
  // Trạng thái workflow cực kỳ chi tiết
  // DANG_KY, DA_THANH_TOAN, DA_DEN, DANG_CHO, DANG_KHAM, CHO_CLS, DA_KET_LUAN, HOAN_TAT, HUY
  status            String   @default("DANG_KY") 
  
  // Loại khám
  type              String   @default("BHYT") // BHYT, DICH_VU, THEO_YEU_CAU, CHUYEN_GIA
  healthInsuranceNo String?
  
  notes             String?
  symptoms          String?  // Lý do khám
  diagnosis         String?  // Chẩn đoán sau khi khám
  
  queueNumber       String?  // Số thứ tự vào khám "A015"

  // Liên kết người bệnh
  patientId         String
  patient           User     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Liên kết nơi khám
  departmentId      String
  department        Department @relation(fields: [departmentId], references: [id]) // Tới Phòng khám nào

  doctorId          String?
  doctor            Doctor?   @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  serviceComboId    String?
  serviceCombo      ServiceCombo? @relation(fields: [serviceComboId], references: [id])

  invoices          Invoice[]
  prescriptions     Prescription[]
  labOrders         LabOrder[]
  medicalRecord     MedicalRecord?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([departmentId])
  @@index([date])
  @@index([status])
}

model MedicalRecord {
  id            String   @id @default(cuid())
  diagnosis     String
  treatment     String
  notes         String?
  icdCode       String?  // Mã bệnh ICD-10

  patientId     String
  patient       User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String   @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ----------------------------------------------------------------------
// THANH TOÁN (BILLING & INVOICE)
// ----------------------------------------------------------------------

model Invoice {
  id               String        @id @default(cuid())
  invoiceNo        String        @unique
  type             String        @default("TONG_HOP") // PHI_KHAM, PHI_CLS, PHI_THUOC, TONG_HOP
  
  totalAmount      Float         @default(0) // Tổng chi phí
  healthInsurance  Float         @default(0) // BHYT trả
  patientAmount    Float         @default(0) // BN trả
  
  status           String        @default("CHO_THANH_TOAN") // CHO_THANH_TOAN, DA_THANH_TOAN, HOAN_TIEN, HUY
  paymentMethod    String?       // TIEN_MAT, CHUYEN_KHOAN, QR, POS
  paidDate         DateTime?
  
  notes            String?

  appointmentId    String?
  appointment      Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  inpatientRecordId String?
  inpatientRecord   InpatientRecord? @relation(fields: [inpatientRecordId], references: [id], onDelete: Cascade)

  items            InvoiceItem[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([appointmentId])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  description String
  amount      Float
  quantity    Int     @default(1)

  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------
// CẬN LÂM SÀNG (DIAGNOSTICS & LABS)
// ----------------------------------------------------------------------

model LabOrder {
  id            String   @id @default(cuid())
  type          String   // XET_NGHIEM, CDHA, NOI_SOI, GPB
  name          String   // Tên dịch vụ: "Siêu âm ổ bụng", "Công thức máu"
  description   String?
  price         Float    @default(0) 
  
  result        String?  // Kết luận
  resultFileUrl String?  // File kết quả
  
  status        String   @default("CHO_THANH_TOAN") // CHO_THANH_TOAN, DA_THANH_TOAN, DANG_THUC_HIEN, DA_CO_KET_QUA, HUY
  orderDate     DateTime @default(now())
  completedDate DateTime?

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([appointmentId])
  @@index([status])
}

// ----------------------------------------------------------------------
// ĐƠN THUỐC & DƯỢC
// ----------------------------------------------------------------------

model Prescription {
  id            String   @id @default(cuid())
  notes         String?  // Lời dặn của bác sĩ
  status        String   @default("CHO_THANH_TOAN") // CHO_THANH_TOAN, DA_THANH_TOAN, DA_PHAT_THUOC, HUY
  
  appointmentId String?  @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         PrescriptionItem[]
}

model PrescriptionItem {
  id             String   @id @default(cuid())
  dosage         String   // Liều dùng: "2 viên/ngày"
  duration       String   // Số ngày: "7 ngày"
  instructions   String?  // Cách dùng: "Uống sau ăn"
  quantity       Int      @default(1) 
  price          Float    @default(0) // Lưu giá lúc kê đơn

  medicineId     String
  medicine       Medicine @relation(fields: [medicineId], references: [id])
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model Medicine {
  id          String   @id @default(cuid())
  name        String
  activeIngredient String? 
  unit        String   @default("Viên") 
  category    String   @default("GENERAL") 
  description String?
  inventory   Int      @default(0)
  price       Float    @default(0) 
  costPrice   Float    @default(0) 
  minStock    Int      @default(10)
  status      String   @default("ACTIVE") 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prescriptionItems PrescriptionItem[]
}

model MedicalSupply {
  id          String   @id @default(cuid())
  name        String
  unit        String   @default("Cái") 
  category    String   @default("GENERAL") 
  description String?
  inventory   Int      @default(0)
  price       Float    @default(0) 
  status      String   @default("ACTIVE") 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ----------------------------------------------------------------------
// ĐIỀU TRỊ NỘI TRÚ & PHÒNG BỆNH
// ----------------------------------------------------------------------

model Room {
  id         String   @id @default(cuid())
  name       String   @unique 
  type       String   @default("NORMAL") 
  status     String   @default("AVAILABLE") 
  floor      Int?
  capacity   Int      @default(1)
  ratePerDay Float    @default(0) 
  
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  beds         RoomBed[]
}

model RoomBed {
  id         String   @id @default(cuid())
  bedNumber  String   
  status     String   @default("AVAILABLE") 
  
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  
  inpatientRecords InpatientRecord[]
  
  @@unique([roomId, bedNumber])
}

model InpatientRecord {
  id            String   @id @default(cuid())
  admissionDate DateTime @default(now())
  dischargeDate DateTime?
  reason        String   
  status        String   @default("ADMITTED") 
  notes         String?

  patientId     String
  patient       User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  doctorId      String
  doctor        Doctor   @relation(fields: [doctorId], references: [id])
  
  roomBedId     String?
  roomBed       RoomBed? @relation(fields: [roomBedId], references: [id], onDelete: SetNull)

  medicalOrders MedicalOrder[]
  invoices      Invoice[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MedicalOrder {
  id                String   @id @default(cuid())
  orderText         String   
  status            String   @default("PENDING") 

  inpatientRecordId String
  inpatientRecord   InpatientRecord @relation(fields: [inpatientRecordId], references: [id], onDelete: Cascade)

  doctorId          String
  doctor            Doctor   @relation(fields: [doctorId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SurgeryOrder {
  id              String   @id @default(cuid())
  surgeryName     String   
  scheduledDate   DateTime?
  diagnosisBefore String   
  status          String   @default("PENDING") 

  patientId       String
  patient         User     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  doctorId        String
  doctor          Doctor   @relation(fields: [doctorId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ----------------------------------------------------------------------
// BÀI VIẾT (TIN TỨC)
// ----------------------------------------------------------------------

model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  coverImage  String?
  category    String   @default("NEWS") 
  viewCount   Int      @default(0)

  authorId    String
  author      User     @relation(fields: [authorId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceCombo {
  id        String  @id @default(cuid())
  name      String
  description String?
  price     Float   @default(0)
  status    String  @default("ACTIVE") 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments       Appointment[]
}
